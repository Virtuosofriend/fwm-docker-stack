    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory (% of limit)",
      "description": "Memory each container uses against its own limit. Containers without a limit (Postgres) are not shown. Alert above 80% for 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "fwm-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 13
      },
