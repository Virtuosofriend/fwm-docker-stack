        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fwm-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "100 * container_memory_working_set_bytes{name=~\"fwm-(next-app|directus|crawlers|postgres|cache|forecastmap)\"} / (container_spec_memory_limit_bytes{name=~\"fwm-(next-app|directus|crawlers|postgres|cache|forecastmap)\"} > 0)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
